{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "/site" },
    { "source": "/site", "destination": "/site" },
    { "source": "/home", "destination": "/site" },
    { "source": "/suaagencia", "destination": "/cadastro" },
    { "source": "/sua-agencia", "destination": "/cadastro" },
    { "source": "/nova-agencia", "destination": "/cadastro" },
    { "source": "/apresentacao", "destination": "/apresentacao-comercial" },
    { "source": "/apresentacao-comercial", "destination": "/apresentacao-comercial" },
    { "source": "/apresentacao-familia", "destination": "/apresentacao-familia" },
    { "source": "/case-cuidelar", "destination": "/apresentacao-familia" },
    { "source": "/demonstracao", "destination": "/apresentacao-familia" },
    { "source": "/login", "destination": "/index" },
    { "source": "/cuidador", "destination": "/dashboard-cuidador" },
    { "source": "/familia", "destination": "/dashboard-familia" },
    { "source": "/admin", "destination": "/dashboard-admin" },
    { "source": "/:tenant/login", "destination": "/index" },
    { "source": "/:tenant/cuidador", "destination": "/dashboard-cuidador" },
    { "source": "/:tenant/familia", "destination": "/dashboard-familia" },
    { "source": "/:tenant/admin", "destination": "/dashboard-admin" },
    { "source": "/:tenant", "destination": "/index" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
